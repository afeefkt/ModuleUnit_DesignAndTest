  "local-recommended": {
    "label": "Local - recommended",
    "note": "One 16k-context model (qwen3:8b-ctx16384) for every MUD stage: fits an 8 GB GPU and avoids model swaps between stages. deepseek-r1:7b loads a 131k context by default — create a capped variant (see docs/providers.md) before selecting it.",
