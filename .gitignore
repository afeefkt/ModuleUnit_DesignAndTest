# ── Secrets / local env ─────────────────────────────────────────────
# Real env files are NEVER committed. Only *.example templates are tracked.
.env
.env.local
.env.auto
**/.env
!**/*.example

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv*/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/

# ── MUD_MUT outputs & config ─────────────────────────────────────────
# Runs live under outputs/<run>/; only the .gitkeep is tracked.
# Third-party tool checkouts (e.g. a CppUTest clone + its build/install) — never tracked.
Tools/
outputs/*
!outputs/.gitkeep
config/stages.json
config/settings.json
config/model_probe.json
config/stage_timings.json
*.bak*
*.backup
*.sqlite-journal
**/data/elaborated/
**/guidelines_cache/
# Legacy generated dirs (deleted in Phase 1).
workspace/
cpputest-rag/generated_tests/
cpputest-rag/c_projects/

# ── Node / frontend tooling (if any) ────────────────────────────────
node_modules/

# ── Claude / IDE / local worktrees ──────────────────────────────────
**/.claude/settings.local.json
**/.claude/worktrees/
.vscode/*
!.vscode/extensions.json

# ── Generated / cached artifacts ────────────────────────────────────
graphify-out/cache/
**/output/
**/logs/*.log

# ── Agentic spike (agentic/) ─────────────────────────────────────────
agentic/runs/
agentic/eval/.cache/
.venv-agentic/
__pycache__/
*.pyc

# ── OpenCode runtime junk (regenerated on `opencode run`/`serve`) ────
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json

# ── Databases ───────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── OS cruft ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# RAG index / logs written by the in-process cpputest-rag engine
test_examples.index
test_examples_meta.pkl
**/data/test_examples.index
**/data/test_examples_meta.pkl
cpputest_generator.log
**/generated_tests/tests_*/
